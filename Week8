ones = ["zero", "one", "two", "three", "four", "five", "six",
        "seven", "eight", "nine", "ten", "eleven", "twelve",
        "thirteen", "fourteen", "fifteen", "sixteen", "seventeen",
        "eighteen", "nineteen"]

tens = ["", "", "twenty", "thirty", "forty",
        "fifty", "sixty", "seventy", "eighty", "ninety"]


def number_word(n):
    if n < 20:
        return ones[n]

    if n < 100:
        if n % 10 == 0:
            return tens[n // 10]
        return tens[n // 10] + "-" + ones[n % 10]

    return "one hundred"


def make_text(amount):
    dollars = int(amount)
    cents = round((amount - dollars) * 100)

    if dollars == 1:
        dollar_text = "one dollar"
    else:
        dollar_text = number_word(dollars) + " dollars"

    if cents == 1:
        cent_text = "one cent"
    else:
        cent_text = number_word(cents) + " cents"

    return "only " + dollar_text + " and " + cent_text


file = open("checks.txt", "r")

for line in file:
    parts = line.strip().split(maxsplit=1)

    amount = float(parts[0])
    written = parts[1].lower()

    expected = make_text(amount)

    print(line.strip())

    if written == expected:
        print("VALID")
    else:
        print("INVALID")
        print("Should be:", expected)

    print()

file.close()
